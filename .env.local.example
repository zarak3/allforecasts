# Copy this file to .env.local for local development, and add the same
# values in Vercel: Project -> Settings -> Environment Variables.
#
# Both come from your Supabase project: Project Settings -> API.
# Use the service_role key (NOT anon) -- this app is read/write server-side
# only, so the key never reaches the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Any random string. Vercel automatically sends it as a Bearer token when
# it triggers the cron job (see vercel.json), and you can use the same
# value to trigger a manual refresh via curl. Optional locally.
CRON_SECRET=change-me-to-something-random

# Powers Zeno (app/api/ask) and the weekly digest narration. Genuinely
# free within the free-tier quota -- but the Google Cloud project behind
# it needs a card on file for one-time identity verification (won't
# actually charge within free limits). Get a key at aistudio.google.com/
# apikey once verified. Without this set, Zeno shows a "not switched on
# yet" error but the rest of the site works fine.
GEMINI_API_KEY=AIza...

# Powers Zeno's live web search. Free, no credit card required -- get a key
# at app.tavily.com (1,000 searches/month free). Without this set, Zeno's
# web_search tool returns a "not configured" error but everything else works.
TAVILY_API_KEY=tvly-...
